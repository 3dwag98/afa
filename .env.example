# AFA environment variable overrides.
# Copy to .env and edit as needed. Uses the AFA_ prefix with double-underscore
# nesting to match config.yaml's structure (see portfolio_agent/config/loader.py).
#
# Example: AFA_TRAINING__DEVICE=cuda overrides training.device
# Example: AFA_RISK__PORTFOLIO_VALUE_INR=500000 overrides risk.portfolio_value_inr

# AFA_RISK__PORTFOLIO_VALUE_INR=308733
# AFA_RISK__RISK_PER_TRADE_PCT=0.01
# AFA_COMPLIANCE__PAPER_TRADING_MODE=true
# AFA_TRAINING__DEVICE=auto
# AFA_DATA__UNIVERSE_SIZE=4000
