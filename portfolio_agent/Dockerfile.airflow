# Apache Airflow Docker Image for Portfolio Agent
FROM apache/airflow:2.10.4-python3.11

# Labels
LABEL project="portfolio_agent"
LABEL component="airflow"
LABEL purpose="scheduled portfolio agent orchestration"

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV TZ=Asia/Kolkata
ENV AIRFLOW_HOME=/opt/airflow
ENV PYTHONPATH=/opt/airflow/project

# Set working directory
WORKDIR /opt/airflow

# Copy and install requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Create necessary directories
RUN mkdir -p /opt/airflow/dags \
    && mkdir -p /opt/airflow/project \
    && mkdir -p /opt/airflow/project/data \
    && mkdir -p /opt/airflow/project/output \
    && mkdir -p /opt/airflow/project/logs

# Set ownership so airflow user can write to these directories
RUN chown -R airflow:airflow /opt/airflow/dags \
    && chown -R airflow:airflow /opt/airflow/project/data \
    && chown -R airflow:airflow /opt/airflow/project/output \
    && chown -R airflow:airflow /opt/airflow/project/logs

# Note: No CMD specified - to be provided by docker-compose or docker run
