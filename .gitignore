```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Dependencies
venv/
.venv/
.env
.env.local
*.env.*

# Logs
*.log

# Coverage reports
.coverage
htmlcov/
coverage/

# IDE specific
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Build artifacts
dist/
build/
target/
*.out

# Cache directories
.mypy_cache/
.pytest_cache/
```