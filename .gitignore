# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py~
*.py.class
*.py.backup

# Dependencies / environments
.venv/
venv/
env/
.env
.env.local
.env.*
!.env.example

# Data, model, and output artifacts (regenerated by the CLI, not committed)
data/
models/*.pt
models/metadata.json
output/*.xlsx
logs/

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Editors
.vscode/
.idea/

# Coverage reports
.coverage
coverage/
htmlcov/

# Testing
.pytest_cache/
.mypy_cache/

# Build artifacts
*.egg-info/

# Notebook run artifacts. The standalone notebooks download parquet into
# data_cache/ next to wherever they are run, and Jupyter writes checkpoints.
.ipynb_checkpoints/
notebooks/**/data_cache/
data_cache/
