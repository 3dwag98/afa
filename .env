# AFA Project Environment Configuration

# Timezone
TZ=Asia/Kolkata

# Portfolio Agent Configuration (PA_ prefix)
PA_PORTFOLIO_VALUE_INR=308733
PA_RISK_PER_TRADE_PCT=0.01
PA_MAX_SINGLE_POSITION_PCT=0.03
PA_MIN_PRICE_INR=20
PA_TARGET_PROB_PROFIT=0.55
PA_MIN_REWARD_RISK=1.5
PA_LEARNING_RATE=0.15
PA_PAPER_TRADING_MODE=true

# Directory Paths (for Docker)
PA_DATA_DIR=/app/data
PA_MARKET_DATA_DIR=/app/data/market_data
PA_OUTPUT_DIR=/app/output
PA_LOG_DIR=/app/logs
PA_SQLITE_PATH=/app/data/portfolio_agent.db
PA_BRAIN_FILE=/app/data/agent_brain.json
PA_EXCEL_OUTPUT=/app/output/Agent_Orchestrator_Output.xlsx

# Backtest Defaults (BACKTEST_ prefix)
PA_BACKTEST_EXCEL_OUTPUT=/app/output/Backtest_Report.xlsx
BACKTEST_DEFAULT_YEARS=5
BACKTEST_DEFAULT_UNIVERSE_SIZE=
BACKTEST_FORCE_DOWNLOAD=false

# Airflow Configuration
COMPOSE_PROJECT_NAME=afa
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=ZmVybmV0X2tleV9mb3JfYWlyZmxvd19lbmNyeXB0aW9uXzEyMzQ1Njc4OTA=
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=True

# Airflow User Credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
_AIRFLOW_WWW_USER_EMAIL=admin@afa.local
_AIRFLOW_WWW_USER_FIRSTNAME=Admin
_AIRFLOW_WWW_USER_LASTNAME=User

# Python Path
PYTHONPATH=/opt/airflow/project:/workspace

# Logging
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# Database Credentials
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
